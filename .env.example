# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Which market-data adapter to use.
#   mock  -> deterministic local simulation (clearly labelled as SIMULATED)
#   live  -> real prices from Upstox (see the Upstox section below)
MARKET_DATA_ADAPTER=mock

# Mirrored to the browser so the UI can render the correct data-source badge.
# This must never carry a secret — it is only a mode flag.
#   simulated -> the UI says SIMULATED and the local simulator runs
#   live      -> the UI says LIVE and the simulator stands down for any
#                instrument Upstox can quote
NEXT_PUBLIC_MARKET_DATA_MODE=simulated

# To run on real Upstox prices, set all three:
#   MARKET_DATA_ADAPTER=live
#   NEXT_PUBLIC_MARKET_DATA_MODE=live
#   UPSTOX_ACCESS_TOKEN=<token>       (below — server only)
#
# Upstox supplies prices only. Orders are simulated inside this app against
# virtual cash and are never sent to Upstox or to any broker.

# Credentials for a live provider. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# MARKET_DATA_API_KEY=
# MARKET_DATA_API_SECRET=
# MARKET_DATA_WS_URL=

# ---------------------------------------------------------------------------
# Upstox (live market data)
# ---------------------------------------------------------------------------
# Register an app at https://developer.upstox.com to get a client_id/secret
# and to set your redirect URI. SERVER ONLY — never prefix with NEXT_PUBLIC_.
#
# UPSTOX_API_KEY=          # Upstox "client_id"
# UPSTOX_API_SECRET=       # Upstox "client_secret"
# UPSTOX_REDIRECT_URI=http://localhost:3000/api/market-data/upstox/callback
#
# Access tokens issued via the OAuth flow (or generated manually in the Upstox
# developer console) expire every day at around 3:30 AM IST. Visiting
# /api/market-data/upstox/login refreshes the token automatically and stores
# it in memory; UPSTOX_ACCESS_TOKEN below is only a manual fallback for when
# you'd rather paste a freshly generated token than run the login flow.
# It needs to be replaced once a day if you rely on it instead of the login
# route.
#
# Put the real value in `.env`, which is gitignored. It is read only through
# `serverEnv`, which throws if it is ever touched from a browser bundle, and it
# is never echoed in an API response, a log line, or the price stream.
# UPSTOX_ACCESS_TOKEN=

# Which instruments the live feed subscribes to. Defaults to the five this
# integration was brought up against. Upstox caps instruments per connection,
# and a short list is far easier to diagnose than the whole registry. Set to
# "*" for every mapped instrument. SERVER ONLY.
# UPSTOX_LIVE_SYMBOLS=RELIANCE,HDFCBANK,TCS,INFY,SUDARSCHEM

# Instrument keys are NOT configured here. Upstox identifies instruments by an
# ISIN-based key (NSE_EQ|INE002A01018) that cannot be derived from the trading
# symbol, so the mapping is generated from Upstox's own published master:
#
#   node scripts/refresh-upstox-keys.mjs
#
# Re-run it when the instrument universe changes or a symbol stops ticking.

# ---------------------------------------------------------------------------
# Trade analysis (optional)
# ---------------------------------------------------------------------------
# Without a key, trade reviews are produced by a deterministic local reviewer.
# That is the full experience, not a degraded one — the same trade always
# yields the same review, and every sentence is generated from the trade's own
# figures. A model key only changes the phrasing.
#
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# ANALYSIS_API_KEY=

# ---------------------------------------------------------------------------
# Database — required for paper trading
# ---------------------------------------------------------------------------
# The trading engine stores accounts, holdings, orders, trades and the cash
# ledger in PostgreSQL. Without it the app still runs — market data, charts and
# the risk simulator all work — but the trading routes return 503 and the
# portfolio page shows setup instructions instead of balances.
#
# Prisma reads this from `.env` (not `.env.local`), so put it there.
#
#   1. createdb parallel
#   2. add the line below to .env with your credentials
#   3. npx prisma migrate deploy   (or `migrate dev` while developing)
#
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/parallel?schema=public"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# No secret is required. Sessions are random 256-bit tokens stored hashed in
# the database and carried in an httpOnly cookie — there is no signing key to
# leak, rotate, or accidentally ship to the browser.
#
# Passwords are hashed with scrypt (salt and cost parameters stored per record).
# Nothing in the auth path reads an environment variable other than DATABASE_URL.
#
# In production, serve over HTTPS: the session cookie sets the Secure flag when
# NODE_ENV=production, and a browser will not send a Secure cookie over http.

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# From the Google Cloud Console: APIs & Services -> Credentials -> Create
# credentials -> OAuth client ID -> Web application.
#
# The Authorised redirect URI must match EXACTLY, including scheme and port:
#   http://localhost:3000/api/auth/google/callback      (local)
#   https://your-domain.com/api/auth/google/callback    (production)
#
# The callback URL is derived from APP_URL below, so the two must agree.
#
# Both are optional. Without them the "Continue with Google" button is not
# rendered at all, rather than shown and broken.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (verification + password reset)
# ---------------------------------------------------------------------------
# Used to send email-verification links and password-reset codes. SERVER ONLY —
# never prefix either of these with NEXT_PUBLIC_.
#
# Without them the app still runs and both forms still return their usual
# generic responses; no mail is sent, and a warning is logged. That is
# deliberate: the response must not differ based on configuration, or it would
# reveal which addresses are registered.
#
# Note that without a mail provider, a new sign-up cannot confirm its address
# and therefore cannot sign in. Set these before letting anyone register.
#
# Get a key at https://resend.com. The From domain must be verified with Resend
# or every send is rejected; while testing you may send to your own Resend
# account address using their onboarding sender.
# RESEND_API_KEY=re_...
# EMAIL_FROM="STOCKX <no-reply@yourdomain.com>"

# The app's own public origin. Used to build the absolute links in email and
# the Google OAuth redirect URI.
#
# Never derived from the request's Host header: that header is attacker
# controlled, and trusting it is how a reset email ends up pointing at someone
# else's server with a live token attached.
#
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL
# automatically, so it only needs setting for a custom domain or local testing.
# APP_URL=http://localhost:3000
